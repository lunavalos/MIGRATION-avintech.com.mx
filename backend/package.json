    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "cross-env": "^7.0.3",
    "graphql": "^16.9.0",
    "next": "16.4.6",
    "payload": "3.93.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sharp": "^0.34.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
